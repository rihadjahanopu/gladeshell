# EditorConfig — consistent coding style across all editors
# https://editorconfig.org

root = true

# ── All files ─────────────────────────────────────────────────
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# ── Shell scripts ─────────────────────────────────────────────
[*.{sh,zsh,fish,bash}]
indent_style = space
indent_size = 2

# ── PowerShell ────────────────────────────────────────────────
[*.{ps1,psm1,psd1}]
indent_style = space
indent_size = 4

# ── Batch / Windows ───────────────────────────────────────────
[*.bat]
end_of_line = crlf
indent_style = space
indent_size = 2

# ── Markdown ──────────────────────────────────────────────────
[*.md]
trim_trailing_whitespace = false
indent_size = 2

# ── YAML (GitHub Actions, config) ─────────────────────────────
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# ── JSON ──────────────────────────────────────────────────────
[*.json]
indent_style = space
indent_size = 2

# ── HTML / CSS / JS (web/) ────────────────────────────────────
[*.{html,css,js}]
indent_style = space
indent_size = 2

# ── XML ───────────────────────────────────────────────────────
[*.xml]
indent_style = space
indent_size = 2

# ── Makefile ──────────────────────────────────────────────────
[Makefile]
indent_style = tab
