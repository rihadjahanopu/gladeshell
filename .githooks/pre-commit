#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║           fancybash — Bulletproof Auto-Sync Pre-Commit Hook                ║
# ║                                                                            ║
# ║  What it does:                                                             ║
# ║    1. i.sh, u.sh            → web/                                        ║
# ║    2. install.*, config.*,  → web/public/                                 ║
# ║       uninstall.*, i.ps1                                                  ║
# ║    3. zed/install-settings.sh → web/public/zed/                           ║
# ║    4. Cleans stale .zwc files & loose files from web/ root                ║
# ║                                                                            ║
# ║  Skip hook:   FANCYBASH_SKIP_SYNC=1 git commit                            ║
# ║  Dry run:     FANCYBASH_DRY_RUN=1  git commit                             ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# ─── Terminal Colors ──────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  DIM='\033[2m'
  RESET='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' DIM='' RESET=''
fi

# ─── Helpers ──────────────────────────────────────────────────────────────────
info()    { echo -e "${CYAN}  →${RESET} $*"; }
success() { echo -e "${GREEN}  ✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}  ⚠${RESET} $*"; }
skip()    { echo -e "${DIM}  ⊘${RESET} ${DIM}$*${RESET}"; }
error()   { echo -e "${RED}  ✖${RESET} ${BOLD}$*${RESET}" >&2; }
header()  { echo -e "\n${BOLD}${CYAN}$*${RESET}"; }

# ─── Bypass Flags ────────────────────────────────────────────────────────────
if [[ "${FANCYBASH_SKIP_SYNC:-0}" == "1" ]]; then
  warn "FANCYBASH_SKIP_SYNC=1 detected — skipping auto-sync hook entirely."
  exit 0
fi

DRY_RUN=false
if [[ "${FANCYBASH_DRY_RUN:-0}" == "1" ]]; then
  DRY_RUN=true
  warn "FANCYBASH_DRY_RUN=1 — no files will be written or staged."
fi

# ─── Resolve repo root ────────────────────────────────────────────────────────
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && git rev-parse --show-toplevel 2>/dev/null)" || {
  error "Could not determine git repo root. Is this a git repository?"
  exit 1
}
cd "$REPO_ROOT"

# ─── Rollback Registry ───────────────────────────────────────────────────────
# Tracks files copied so we can remove them if something goes wrong mid-run
declare -a COPIED_FILES=()

cleanup_on_failure() {
  local exit_code=$?
  if (( exit_code != 0 )) && (( ${#COPIED_FILES[@]} > 0 )); then
    warn "Hook failed (exit $exit_code). Rolling back partial copies..."
    for f in "${COPIED_FILES[@]}"; do
      rm -f "$f" && skip "Removed: $f"
    done
  fi
}
trap cleanup_on_failure EXIT

# ─── Staged File Detection ────────────────────────────────────────────────────
# Get all staged file paths (added/modified/renamed)
STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null || true)"

is_staged() {
  # Returns 0 (true) if the given path is staged
  local file="$1"
  echo "$STAGED_FILES" | grep -qF "$file"
}

any_staged_matching() {
  # Returns 0 (true) if any staged file matches the given glob pattern
  local pattern="$1"
  echo "$STAGED_FILES" | grep -qE "$pattern"
}

# ─── Safe Copy with Verification ─────────────────────────────────────────────
safe_copy() {
  local src="$1"
  local dst="$2"
  local label="${3:-$src}"

  if [[ ! -f "$src" ]]; then
    skip "Missing source, skipping:  $src"
    return 0
  fi

  if $DRY_RUN; then
    info "[DRY-RUN] Would copy: $src → $dst"
    return 0
  fi

  mkdir -p "$(dirname "$dst")"

  # Copy and verify integrity via byte count comparison
  local src_size dst_size
  src_size=$(wc -c < "$src")
  cp -f "$src" "$dst"
  dst_size=$(wc -c < "$dst")

  if [[ "$src_size" != "$dst_size" ]]; then
    error "Copy verification failed for '$label' (src: ${src_size}B, dst: ${dst_size}B)"
    return 1
  fi

  COPIED_FILES+=("$dst")
  git add "$dst" 2>/dev/null || true
  success "Synced:  ${DIM}$src${RESET} → ${DIM}$dst${RESET}"
}

# ─── Determine Which Source Files Are Relevant ────────────────────────────────
WEB_ROOT_FILES=("i.sh" "u.sh")

PUBLIC_FILES=(
  "install.sh"
  "install.zsh"
  "install.fish"
  "install.ps1"
  "install.bat"
  "config.sh"
  "config.zsh"
  "config.fish"
  "config.ps1"
  "i.ps1"
  "uninstall.sh"
  "uninstall.zsh"
  "uninstall.fish"
  "uninstall.ps1"
)

ZED_FILES=("zed/install-settings.sh")

# Check if any sync-relevant file is staged
SYNC_NEEDED=false
for f in "${WEB_ROOT_FILES[@]}" "${PUBLIC_FILES[@]}" "${ZED_FILES[@]}"; do
  if is_staged "$f"; then
    SYNC_NEEDED=true
    break
  fi
done

# ─── Header ──────────────────────────────────────────────────────────────────
header "◆ fancybash pre-commit: Auto-Sync"

if ! $SYNC_NEEDED; then
  skip "No sync-relevant files staged — skipping sync (commit proceeds normally)."
  echo ""
  exit 0
fi

# ─── 1. Web Root Entrypoints ──────────────────────────────────────────────────
web_root_synced=0
for f in "${WEB_ROOT_FILES[@]}"; do
  if is_staged "$f" || [[ ! -f "web/$f" ]]; then
    safe_copy "$f" "web/$f" && (( web_root_synced++ )) || true
  else
    skip "Unchanged (not staged): $f"
  fi
done

# ─── 2. Public Installer / Config Files ───────────────────────────────────────
public_synced=0
for f in "${PUBLIC_FILES[@]}"; do
  if is_staged "$f" || [[ ! -f "web/public/$f" ]]; then
    safe_copy "$f" "web/public/$f" && (( public_synced++ )) || true
  else
    skip "Unchanged (not staged): $f"
  fi
done

# ─── 3. Zed Scripts ───────────────────────────────────────────────────────────
zed_synced=0
for f in "${ZED_FILES[@]}"; do
  dst="web/public/${f#zed/}"
  dst="web/public/zed/$(basename "$f")"
  if is_staged "$f" || [[ ! -f "$dst" ]]; then
    safe_copy "$f" "$dst" && (( zed_synced++ )) || true
  else
    skip "Unchanged (not staged): $f"
  fi
done

# ─── 4. Cleanup: Stale / Forbidden Files ─────────────────────────────────────
removed_count=0

# Remove loose installer/config files accidentally placed in web/ root
stale_web_root=(web/config.* web/install.* web/i.ps1 web/uninstall.*)
for pattern in "${stale_web_root[@]}"; do
  for f in $pattern; do
    if [[ -f "$f" ]]; then
      if ! $DRY_RUN; then
        git rm --cached -f "$f" 2>/dev/null || true
        rm -f "$f"
      fi
      warn "Removed stale file from web/ root: ${DIM}$f${RESET}"
      (( removed_count++ ))
    fi
  done
done

# Remove .zwc (Zsh compiled cache) — binary, machine-specific, not for deployment
zwc_count=0
while IFS= read -r -d '' zwc_file; do
  if ! $DRY_RUN; then
    git rm --cached -f "$zwc_file" 2>/dev/null || true
    rm -f "$zwc_file"
  fi
  warn "Removed .zwc cache: ${DIM}$zwc_file${RESET}"
  (( zwc_count++ ))
done < <(find . -name "*.zwc" -not -path "./.git/*" -print0 2>/dev/null)

# ─── Summary ─────────────────────────────────────────────────────────────────
total=$(( web_root_synced + public_synced + zed_synced ))
echo ""
echo -e "${BOLD}  Summary:${RESET}"
echo -e "  ${GREEN}✔${RESET} ${total} file(s) synced  ${DIM}(web root: ${web_root_synced}, public: ${public_synced}, zed: ${zed_synced})${RESET}"
(( removed_count > 0 )) && echo -e "  ${YELLOW}⚠${RESET}  ${removed_count} stale file(s) removed from web/ root"
(( zwc_count > 0 ))    && echo -e "  ${YELLOW}⚠${RESET}  ${zwc_count} .zwc cache file(s) purged"
$DRY_RUN               && echo -e "  ${YELLOW}⚠${RESET}  Dry-run mode — no actual changes made"
echo ""

# Disable the rollback trap on clean exit
trap - EXIT
