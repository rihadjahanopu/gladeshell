#!/usr/bin/env bash
# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║             fancybash — Bulletproof Pre-Push Test Suite Hook             ║
# ║                                                                            ║
# ║  What it does:                                                             ║
# ║    1. Verifies workspace compilation (cargo check --workspace --all-targets)║
# ║    2. Runs full test suite (cargo test --workspace)                         ║
# ║                                                                            ║
# ║  Skip controls:                                                            ║
# ║    SKIP_PRE_PUSH=1 git push           (Skip pre-push checks)               ║
# ║    git push --no-verify               (Bypass all git hooks)                ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

set -euo pipefail

# ─── Terminal Colors ──────────────────────────────────────────────────────────
if [[ -t 1 ]]; then
  RED='\033[0;31m'
  GREEN='\033[0;32m'
  YELLOW='\033[1;33m'
  CYAN='\033[0;36m'
  BOLD='\033[1m'
  DIM='\033[2m'
  RESET='\033[0m'
else
  RED='' GREEN='' YELLOW='' CYAN='' BOLD='' DIM='' RESET=''
fi

info()    { echo -e "${CYAN}  →${RESET} $*"; }
success() { echo -e "${GREEN}  ✔${RESET} $*"; }
warn()    { echo -e "${YELLOW}  ⚠${RESET} $*"; }
skip()    { echo -e "${DIM}  ⊘${RESET} ${DIM}$*${RESET}"; }
error()   { echo -e "${RED}  ✖${RESET} ${BOLD}$*${RESET}" >&2; }
header()  { echo -e "\n${BOLD}${CYAN}$*${RESET}"; }

# ─── Bypass Flags ─────────────────────────────────────────────────────────────
if [[ "${SKIP_PRE_PUSH:-0}" == "1" || "${FANCYBASH_SKIP_PRE_PUSH:-0}" == "1" ]]; then
  warn "SKIP_PRE_PUSH=1 detected — skipping pre-push test suite execution."
  exit 0
fi

# ─── Resolve Repo Root ────────────────────────────────────────────────────────
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && git rev-parse --show-toplevel 2>/dev/null)" || {
  error "Could not determine git repo root. Is this a git repository?"
  exit 1
}
cd "$REPO_ROOT"

header "◆ fancybash pre-push: Workspace Verification & Test Suite"

# ─── 1. Full Workspace Compilation Check ──────────────────────────────────────
info "1/2 Verifying all workspace targets compile (cargo check)..."
if cargo check --workspace --all-targets; then
  success "Workspace compilation check passed."
else
  error "Cargo compilation check failed. Fix compiler errors before pushing."
  error "To bypass pre-push checks, run: SKIP_PRE_PUSH=1 git push"
  exit 1
fi

# ─── 2. Full Unit Test Suite Execution ────────────────────────────────────────
info "2/2 Running full unit test suite (cargo test --workspace)..."
if cargo test --workspace; then
  success "All workspace unit tests passed successfully."
else
  error "Unit test suite failed! Fix failing tests before pushing to remote."
  error "To bypass pre-push checks, run: SKIP_PRE_PUSH=1 git push"
  exit 1
fi

echo ""
success "${BOLD}Pre-push verification passed! Pushing to remote...${RESET}"
echo ""
exit 0
