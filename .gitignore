# =============================================================================
#  gladeshell — .gitignore
# =============================================================================

# ── Rust / Cargo Target & Build Output ────────────────────────────────────────
/target/
**/*.rs.bk
*.profraw
*.profdata
cargo-timing*.html

# Note: Cargo.lock is intentionally tracked for application binary builds
# to guarantee 100% reproducible cross-platform releases.

# ── Binary Executables & Release Archives ─────────────────────────────────────
gladeshell-linux-*
gladeshell-darwin-*
gladeshell-windows-*
gladeshell-*.tar.gz
gladeshell-*.zip
gladeshell-*.exe
gladeshell
gladeshell.exe
SHA256SUMS*.txt
*.exe
*.pdb
*.d
*.rlib
*.rmeta

# ── IDE & Editor Temporary Files ──────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Operating System Junk Files ───────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs & Temporary Files ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
*.orig
.cache/
dist/
*.zwc

# ── Security & Environment Secrets ────────────────────────────────────────────
.env
.env.local
.env.production
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*

# ── Test & Coverage Reports ───────────────────────────────────────────────────
coverage/
lcov.info

# ── Vault & Encrypted Data ────────────────────────────────────────────────────
*.enc
*.vault
