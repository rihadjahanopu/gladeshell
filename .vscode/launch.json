{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug fancybash (CLI)",
      "cargo": {
        "args": ["build", "--bin=fancybash", "--package=fancybash"],
        "filter": {
          "name": "fancybash",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug fancybash unit tests",
      "cargo": {
        "args": ["test", "--no-run", "--bin=fancybash", "--package=fancybash"],
        "filter": {
          "name": "fancybash",
          "kind": "bin"
        }
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    }
  ]
}
